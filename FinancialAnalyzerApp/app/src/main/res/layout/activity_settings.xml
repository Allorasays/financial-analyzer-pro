<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/moneta_blue">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MONETA - Settings"
            android:textColor="@color/moneta_gold"
            android:textStyle="bold"
            android:textSize="20sp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Personal use only. Add your own licensed API keys below. Keys are stored encrypted on this device."
            android:textColor="@android:color/white"
            android:textSize="13sp"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="FMP API Key (Financial Modeling Prep)"
            android:textColor="@android:color/white"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/editFmpKey"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Your FMP key"
            android:inputType="textPassword"
            android:textColor="@android:color/white"
            android:textColorHint="#AAAAAA"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Alpha Vantage API Key"
            android:textColor="@android:color/white"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/editAlphaVantageKey"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Your Alpha Vantage key"
            android:inputType="textPassword"
            android:textColor="@android:color/white"
            android:textColorHint="#AAAAAA"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Polygon.io API Key"
            android:textColor="@android:color/white"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/editPolygonKey"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Your Polygon key"
            android:inputType="textPassword"
            android:textColor="@android:color/white"
            android:textColorHint="#AAAAAA"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tiingo API Key"
            android:textColor="@android:color/white"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/editTiingoKey"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Your Tiingo key"
            android:inputType="textPassword"
            android:textColor="@android:color/white"
            android:textColorHint="#AAAAAA"
            android:layout_marginBottom="16dp" />

        <Button
            android:id="@+id/btnSaveKeys"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Save API Keys"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnClearKeys"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Clear All Keys"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_marginBottom="24dp" />

        <TextView
            android:id="@+id/txtPrivacy"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Privacy Policy"
            android:textColor="@android:color/white"
            android:layout_marginTop="8dp" />

        <TextView
            android:id="@+id/txtTerms"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Terms of Service"
            android:textColor="@android:color/white"
            android:layout_marginTop="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Version 1.0"
            android:textColor="@android:color/white"
            android:layout_marginTop="24dp" />

    </LinearLayout>

</ScrollView>
