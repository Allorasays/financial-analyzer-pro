# =============================================================================
# PERSONAL USE ONLY
# =============================================================================
# This application is intended for personal, non-commercial use until you obtain
# written permission / API licenses from data providers (FMP, NewsAPI, Alpha
# Vantage, Polygon, Tiingo, etc.). Do not deploy for public users without those
# licenses.
#
# Copy this file to `.env` in the project root and add YOUR OWN keys.
# Never commit `.env` to git.

PERSONAL_USE_ONLY=true
FINANCIALS_CACHE_TTL_SECONDS=1800

# Local backend (personal machine or private Render service)
API_BASE_URL=http://localhost:8000

# --- Third-party keys (personal use — your accounts only) ---
# FMP_API_KEY=your-fmp-key
# ALPHAVANTAGE_API_KEY=your-alpha-vantage-key
# NEWSAPI_KEY=your-newsapi-key
# TIINGO_API_KEY=your-tiingo-key
# POLYGON_API_KEY=your-polygon-key
# FRED_API_KEY=your-fred-key

# Streamlit (optional local dashboard)
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=0.0.0.0

# Email (optional)
# SENDGRID_API_KEY=your-sendgrid-api-key
# FROM_EMAIL=noreply@yourdomain.com
# FROM_NAME=Personal Financial Analyzer
# ENVIRONMENT=development
